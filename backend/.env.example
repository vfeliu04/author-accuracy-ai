# Copy this file to backend/.env and fill in your keys.
# Every value shown is the default the app uses when the variable is unset.

# --- Required API keys ---
# Anthropic powers chat, evidence reranking, verdict classification, and summaries.
ANTHROPIC_API_KEY=your-anthropic-api-key
# OpenAI powers text embeddings only (text-embedding-3-large).
OPENAI_API_KEY=your-openai-api-key

# --- API auth ---
# Shared secret required in the X-API-Key header on every /api/* route.
# WARNING: if left unset, authentication is DISABLED entirely.
API_KEY=dev-api-key

# --- Flask ---
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# --- Storage paths (relative paths resolve against the working directory) ---
DATA_ROOT=./data
SQLITE_PATH=./data/accuracy.db
FAISS_INDEX_DIR=./data/indexes
CACHE_DIR=./data/cache

# --- Models ---
LLM_CHAT_MODEL=claude-sonnet-4-6
EXPLANATION_MODEL=claude-sonnet-4-6
RERANK_MODEL=claude-haiku-4-5
CLAIM_CLASSIFIER_MODEL=claude-haiku-4-5
EMBEDDING_MODEL=text-embedding-3-large

# --- Retrieval / verdict tuning (defaults shown; see docs/configuration.md) ---
RETRIEVAL_SUPPORT_THRESHOLD=0.35
RETRIEVAL_TOP_K=8
RERANK_WITH_GPT=true
RERANK_MAX_CANDIDATES=5

# --- OCR (optional; requires ocrmypdf installed) ---
PDF_OCR_ENABLED=true
PDF_OCR_MIN_TEXT_THRESHOLD=256
PDF_OCR_LOW_QUALITY_RATIO=0.6
OCR_MY_PDF_PATH=/usr/local/bin/ocrmypdf

# --- Table extraction (optional; tabula needs Java + the Tabula jar) ---
# NOTE: keep TABULA_JAR_PATH on ONE line - a wrapped value silently disables
# table extraction with "Tabula jar not found" warnings in the log.
PDF_TABLES_ENGINE=tabula
TABULA_JAR_PATH=/usr/local/tabula/tabula.jar
# PDF_TABLES_API_KEY=            # only for PDF_TABLES_ENGINE=pdftables
# PDF_TABLES_TIMEOUT=30

# --- Chart ingestion (optional; requires opencv + pytesseract) ---
CHART_INGESTION_ENABLED=true

# --- Recommendations (OpenAlex polite pool; set to your email) ---
# OPENALEX_MAILTO=you@example.com
# CROSSREF_MAILTO=you@example.com
