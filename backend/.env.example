# Copy to backend/.env and fill in. Loaded from backend/.env regardless of the
# process working directory (see authorai/config.py). Full settings list with
# defaults: authorai/config.py — every setting is overridable as AUTHORAI_<NAME>.

# Provider keys (unprefixed on purpose — read via validation_alias).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# HTTP API key: the server REFUSES to start without one (fail-closed).
# Clients send it as the X-API-Key header.
AUTHORAI_API_KEY=

# Optional: contact email for polite Crossref access (credibility lookups).
#AUTHORAI_CROSSREF_MAILTO=you@example.com

# Common overrides (defaults shown):
#AUTHORAI_DB_PATH=data/authorai.db
#AUTHORAI_CORS_ORIGINS=http://localhost:5173
#AUTHORAI_DOCS_ENABLED=true   # disable /docs for an exposed deployment
